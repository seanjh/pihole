[Unit]
Description=unbound recursive DNS resolver

[Container]
Image=unbound.build
Network=host
ServiceName=unbound
AddCapability=CAP_MKNOD
Volume=/opt/pihole/unbound/a-records.conf:/opt/unbound/etc/unbound/a-records.conf:ro
Volume=/opt/pihole/unbound/srv-records.conf:/opt/unbound/etc/unbound/srv-records.conf:ro
Volume=/opt/pihole/unbound/forward-records.conf:/opt/unbound/etc/unbound/forward-records.conf:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
